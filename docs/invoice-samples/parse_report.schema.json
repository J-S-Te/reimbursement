{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "reimbursement.invoice-samples.parse-report.schema.v1",
  "type": "object",
  "required": [
    "schema_version",
    "spec_id",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "spec_id": {
      "const": "reimbursement.invoice-samples"
    },
    "parser_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "environment": {
      "type": "object"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file_name",
          "case_code",
          "status",
          "auto_parsed_ok",
          "auto_confirmed",
          "key_fields_correct",
          "manual_only_media",
          "manual_reviewed",
          "crashed",
          "silent_loss"
        ],
        "properties": {
          "file_name": {
            "type": "string"
          },
          "case_code": {
            "type": "string"
          },
          "parse_run_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PARSED",
              "MANUAL",
              "FAILED",
              "MISSING",
              "UNKNOWN"
            ]
          },
          "auto_parsed_ok": {
            "type": "boolean"
          },
          "auto_confirmed": {
            "type": "boolean"
          },
          "key_fields_correct": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "manual_only_media": {
            "type": "boolean"
          },
          "manual_reviewed": {
            "type": "boolean"
          },
          "crashed": {
            "type": "boolean"
          },
          "silent_loss": {
            "type": "boolean"
          },
          "gold_diff": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
