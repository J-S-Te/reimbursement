            "ticket": "NORMAL",
            "variant": "normal",
            "media": "pdf_text",
            "label": "增值税电子普通发票",
            "count": 5,
            "expected": "auto_parse",
            "blocking": true
          },
          {
            "code": "P0-DIGITAL-PDF",
            "ticket": "DIGITAL",
            "variant": "normal",
            "media": "pdf_text",
            "label": "全电发票（数电票，20位号码）",
            "count": 4,
