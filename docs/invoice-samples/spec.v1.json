{
  "spec_id": "reimbursement.invoice-samples",
  "version": "1.0.0",
  "status": "ACTIVE",
  "locale": "zh-CN",
  "purpose": "定义报销子系统发票解析验收所需的授权票样集合、金标准、命名、合规与验收判据，供 AI 与人工共同执行。",
  "consumers": [
    "AI 执行器：清点/分类/打分/出报告",
    "财务：提供样本与金标准",
    "评审人：签字"
  ],
  "decision_rights": {
    "ai_may": [
      "判断样本覆盖是否满足 spec",
      "按文件名与 MIME 分类媒体类型",
      "计算各项验收指标",
      "输出缺失清单并按 owner 分组",
      "判定 REJECTED 及原因",
      "生成报告与证据索引"
    ],
    "human_must": [
      "授权使用真实票据的范围",
      "确认脱敏是否充分",
      "最终签收 ACCEPTED",
      "变更数量门槛与验收阈值",
      "决定新票种是否纳入首发"
    ],
    "ai_must_not": [
      "把未提交的样本计入覆盖",
      "把人工复核结果写成自动解析成功",
      "把缺失样本用合成文件冒充",
      "在阻断项未通过时给出 ACCEPTED",
      "修改 spec 阈值以让结果通过"
    ]
  },
  "capability": {
    "supported_media": [
      {
        "media": "pdf_text",
        "detect": "扩展名 .pdf 且存在文字层",
        "behavior": "区域识别购销方 + 金额守恒 + 多税率行独立保留"
      },
      {
        "media": "ofd",
        "detect": "扩展名 .ofd",
        "behavior": "结构化解析"
      }
    ],
    "manual_only_media": [
      {
        "media": "pdf_image",
        "detect": "扫描 PDF 无文字层",
        "behavior": "必须进入待处理/人工，禁止标记解析成功"
      },
      {
        "media": "image",
        "detect": ".jpg/.jpeg/.png",
        "behavior": "必须进入待处理/人工，禁止标记解析成功"
      }
    ],
    "hard_limits": {
      "max_bytes": 20971520,
      "max_expanded_bytes": 104857600,
      "max_pages": 100,
      "env_overrides": {
        "MAX_BYTES": "REIMBURSEMENT_PARSER_MAX_BYTES",
        "MAX_EXPANDED_BYTES": "REIMBURSEMENT_PARSER_MAX_EXPANDED_BYTES",
        "MAX_PAGES": "REIMBURSEMENT_PARSER_MAX_PAGES"
      },
      "on_exceed": "有界失败并返回明确原因，不得拖垮 API 进程"
    },
    "extraction_fields": [
      "invoice_type",
      "invoice_code",
      "invoice_number",
      "invoice_date",
      "seller_tax_id",
      "buyer_tax_id",
      "total_minor",
      "tax_minor",
      "amount_excl_tax_minor",
      "currency",
      "line_items",
      "remark"
    ],
    "key_fields": [
      "invoice_number",
      "seller_tax_id",
      "buyer_tax_id",
      "total_minor"
    ],
    "source_refs": [
      "reimbursement/internal/invoiceparser/parser.go:16-18",
      "reimbursement/internal/domain/types.go (Invoice struct)",
      "报销管理系统完整开发方案V1.0.docx 第7章、7.6 样本与资源验收"
    ]
  },
  "sample_plan": {
